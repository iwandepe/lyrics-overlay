{
  "manifest_version": 2,
  "name": "Lyrics Overlay Bridge",
  "version": "0.1.0",
  "description": "Tells the Lyrics Overlay desktop app what is playing on YouTube. Talks only to localhost.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lyrics-overlay-bridge@iwandepe.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://music.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
